# Expatus v1.3 production environment template.
# Do not commit a filled .env file. Configure these values in Vercel Production.
APP_ENV=production
SECRET_KEY=
BASE_URL=https://www.expatus.nl
ENFORCE_CANONICAL_HOST=1
COOKIE_SECURE=1
FLASK_DEBUG=0

DATABASE_BACKEND=turso
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Vercel Marketplace 的 expatus_TURSO_* 前缀变量也可直接识别，
# 无需复制或在仓库中保存集成生成的 Token。

DEMO_MODE=0
DEV_SHOW_VERIFICATION_CODE=0
ADMIN_PASSWORD=

# Enable only after the production consent flow and GA property are verified.
ANALYTICS_ENABLED=0
GA_MEASUREMENT_ID=G-FZPQP950J0

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@expatus.nl
SMTP_STARTTLS=1

# Replace every placeholder with verified facts before deployment.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=
PRIVACY_CONTROLLER_COUNTRY=荷兰
HOSTING_REGION=
DATABASE_REGION=
PRIVACY_POLICY_VERSION=2026-08-26-v1.3

LOG_RETENTION_DAYS=90
MESSAGE_RETENTION_DAYS=365
STRATEGY_RETENTION_DAYS=180
