# Required before production deployment
SECRET_KEY=change-this-to-a-long-random-value
BASE_URL=https://expatus.nl
COOKIE_SECURE=1
FLASK_DEBUG=0
PORT=8000

# Local demo helpers. Set both to 0 in production.
DEMO_MODE=1
DEV_SHOW_VERIFICATION_CODE=1

# SMTP: leave SMTP_HOST empty during local development; codes print to the terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=1

# Optional custom database location
# EXPATUS_DB=/path/to/expatus.db


# Internal admin dashboard for submitted rental-dispute cases.
# Leave blank to disable /admin completely. Set a strong unique password before use.
ADMIN_PASSWORD=

# Production database (Vercel Turso integration supplies these automatically)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
